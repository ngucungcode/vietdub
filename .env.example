DUB_API_PORT=8080
DUB_UPLOAD_MEDIA_MAX_BYTES=17179869184
DUB_UPLOAD_SUBTITLE_MAX_BYTES=16777216
DUB_UPLOAD_SESSION_TTL_SECONDS=604800

DUB_OPENSUBTITLES_USER_AGENT="VietDub v0.3.8"

# Host GPU index or stable NVIDIA UUID exposed as logical CUDA device 0.
DUB_GPU_DEVICE_ID=0
# Docker/Compose defaults are the minimal-safe profile for every supported GPU.
# Override these four IDs only after installing a profile that fits logical GPU 0.
DUB_DEFAULT_ASR_MODEL_ID=asr-faster-whisper-small
DUB_DEFAULT_TRANSLATION_MODEL_ID=mt-gemma4-e2b-q4
DUB_DEFAULT_SEPARATION_MODEL_ID=separation-tiger-dnr
DUB_DEFAULT_TTS_MODEL_ID=tts-piper-vi-vais1000-medium
# Set to 0 to disable measured-duration auto rewrite; supported range is 0-3.
DUB_TIMING_REWRITE_MAX_ATTEMPTS=3

OPENSUBTITLES_API_KEY_FILE=./secrets/opensubtitles_api_key.txt
OPENSUBTITLES_TOKEN_FILE=./secrets/opensubtitles_token.txt
# Replace with the exact allowlisted base_url returned by OpenSubtitles login.
DUB_OPENSUBTITLES_URL=https://api.opensubtitles.com/api/v1
PUID=10001
PGID=10001
TZ=Asia/Ho_Chi_Minh
