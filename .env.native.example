# Native managed-container deployment. Secrets are file paths, never values.
# Installer writes CUDA_VISIBLE_DEVICES, DUB_SELECTED_GPU_UUID,
# DUB_SELECTED_CUDA_ARCHITECTURE and DUB_SELECTED_CUDA_TOOLKIT_VERSION after
# the real-GPU preflight. Do not copy a generated .env.native between hosts.
DUB_API_HOST=127.0.0.1
DUB_API_ACCESS_POLICY=local
DUB_API_PORT=8080
DUB_API_URL=http://127.0.0.1:8080
DUB_UPLOAD_MEDIA_MAX_BYTES=17179869184
DUB_UPLOAD_SUBTITLE_MAX_BYTES=16777216
DUB_UPLOAD_SESSION_TTL_SECONDS=604800
DUB_PROWLARR_URL=http://127.0.0.1:9696
DUB_QBITTORRENT_URL=http://127.0.0.1:8081
DUB_QBITTORRENT_USERNAME=dub
DUB_OPENSUBTITLES_URL=https://api.opensubtitles.com/api/v1
DUB_OPENSUBTITLES_USER_AGENT="ThuyetMinhOfflineGPU v0.3.8"
# DUB_OPENSUBTITLES_BASE_URL_FILE defaults to <DUB_NATIVE_ROOT>/secrets/opensubtitles_base_url.

# Phase 2 ASR defaults. The selected ID is frozen into each new job.
DUB_DEFAULT_ASR_MODEL_ID=asr-faster-whisper-large-v3-turbo
DUB_DEFAULT_TRANSLATION_MODEL_ID=mt-gemma4-31b-q4
DUB_DEFAULT_SEPARATION_MODEL_ID=separation-tiger-dnr
DUB_DEFAULT_TTS_MODEL_ID=tts-vieneu-v2
DUB_TTS_SUPPORT_MODEL_ID=tts-neucodec-onnx-int8
DUB_ASR_COMPUTE_TYPE=float16
DUB_ASR_LANGUAGE_CONFIDENCE_THRESHOLD=0.5
DUB_OFFLINE_WORKER_POLL_SECONDS=1.0
DUB_LLAMA_SERVER_BINARY=/usr/local/lib/llama.cpp/llama-server
DUB_LLAMA_SERVER_PORT=18081
DUB_LLAMA_CONTEXT_SIZE=2048
DUB_LLAMA_MAX_OUTPUT_TOKENS=512
DUB_LLAMA_STARTUP_TIMEOUT_SECONDS=300
DUB_LLAMA_REQUEST_TIMEOUT_SECONDS=180
# Set to 0 to disable measured-duration auto rewrite; supported range is 0-3.
DUB_TIMING_REWRITE_MAX_ATTEMPTS=3
# Optional Phase 5; see docs/LIP_SYNC.md before selecting draft/final.
DUB_LATENTSYNC_SOURCE_DIR=/opt/lip-sync/LatentSync
DUB_LATENTSYNC_PYTHON=/opt/lip-sync/latentsync-venv/bin/python
DUB_LATENTSYNC_CHECKPOINT_PATH=/models/lip-sync/latentsync-1.6/latentsync_unet.pt
DUB_LATENTSYNC_CONFIG_PATH=/opt/lip-sync/LatentSync/configs/unet/stage2_512.yaml
DUB_MUSETALK_SOURCE_DIR=/opt/lip-sync/MuseTalk
DUB_MUSETALK_PYTHON=/opt/lip-sync/musetalk-venv/bin/python
DUB_LIP_SYNC_TIMEOUT_SECONDS=21600

# Pinned local Phase 4 runtimes. The worker remains network-disabled.
DUB_TIGER_SOURCE_DIR=/opt/tiger
DUB_VIENEU_ENTRYPOINT=/opt/vieneu/vieneu-offline.py
# VIENEU_CODEC_PATH defaults to <DUB_MODELS_DIR>/tts/support/neucodec-onnx-int8.

# Override only when the provider's persistent disk is mounted elsewhere.
# DUB_NATIVE_ROOT=/workspace/thuyet-minh-offline/var
