# Windows 10 22H2 native runtime. The PowerShell installer selects CPU or GPU
# after probing the real machine. Do not copy a generated file
# between computers.
DUB_COMPUTE_MODE=gpu
DUB_API_HOST=127.0.0.1
DUB_API_ACCESS_POLICY=local
DUB_API_PORT=8080
DUB_API_URL=http://127.0.0.1:8080
DUB_UPLOAD_MEDIA_MAX_BYTES=17179869184
DUB_UPLOAD_SUBTITLE_MAX_BYTES=16777216
DUB_UPLOAD_SESSION_TTL_SECONDS=604800

# Windows MVP supports local media upload. Remote acquisition can be connected
# manually later by providing loopback Prowlarr/qBittorrent URLs and secrets.
DUB_PROWLARR_URL=http://127.0.0.1:9696
DUB_QBITTORRENT_URL=http://127.0.0.1:8081
DUB_QBITTORRENT_USERNAME=dub
DUB_OPENSUBTITLES_URL=https://api.opensubtitles.com/api/v1
DUB_OPENSUBTITLES_USER_AGENT="ThuyetMinhOfflineGPU Windows native"

# Safe defaults for every supported RTX card with at least 6 GiB VRAM. The
# installer replaces these values when -Profile auto selects a larger profile.
DUB_DEFAULT_ASR_MODEL_ID=asr-faster-whisper-small
DUB_DEFAULT_TRANSLATION_MODEL_ID=mt-gemma4-e2b-q4
DUB_DEFAULT_SEPARATION_MODEL_ID=separation-tiger-dnr
DUB_DEFAULT_TTS_MODEL_ID=tts-piper-vi-vais1000-medium
DUB_TTS_SUPPORT_MODEL_ID=tts-neucodec-onnx-int8
DUB_ASR_COMPUTE_TYPE=float16
DUB_ASR_LANGUAGE_CONFIDENCE_THRESHOLD=0.5
DUB_OFFLINE_WORKER_POLL_SECONDS=1.0
DUB_LLAMA_SERVER_PORT=18081
DUB_LLAMA_CONTEXT_SIZE=2048
DUB_LLAMA_MAX_OUTPUT_TOKENS=512
DUB_LLAMA_STARTUP_TIMEOUT_SECONDS=300
DUB_LLAMA_REQUEST_TIMEOUT_SECONDS=180
DUB_LLAMA_GPU_LAYERS=-1
DUB_TIMING_REWRITE_MAX_ATTEMPTS=3

# Optional persistent data location. The default is
# %LOCALAPPDATA%\ThuyetMinhOfflineGPU.
# DUB_NATIVE_ROOT=D:\ThuyetMinhOfflineGPU
