# Cấu hình chuẩn cho máy 6 GB VRAM — xem docs/profile-6gb.md.
#
# Cách dùng (server chạy bằng Docker Compose / systemd / chạy tay):
#   1. Copy file này thành .env của stack rồi restart API + worker, HOẶC
#   2. Bỏ qua file này và bấm nút "Áp dụng cấu hình chuẩn 6GB VRAM" trong
#      form tạo job trên dashboard — nút đó set đúng các giá trị dưới
#      đây cho từng job, không đụng tới cấu hình máy chủ.
# Lưu ý: file này KHÔNG chứa key API. Key nhập ở dashboard (Cài đặt)
# hoặc đặt trong file secret của server, không commit vào repo.
#
# ASR nhỏ nhất (2048 MiB) thay vì large-v3-turbo (6144 MiB, sát nút
# trên card 6 GB mà VRAM khả dụng thực tế chỉ ~5.3-5.7 GB).
DUB_DEFAULT_ASR_MODEL_ID=asr-faster-whisper-small
DUB_ASR_COMPUTE_TYPE=float16
#
# Tách thoại: TIGER-DnR, nhưng chunk 30 s / context 2 s / batch 1 thay
# vì mặc định 120 s / 4 s — đây là núm vặn quyết định OOM hay không
# trên 6 GB. Đừng tăng chunk chỉ vì muốn chạy nhanh hơn.
DUB_DEFAULT_SEPARATION_MODEL_ID=separation-tiger-dnr
DUB_SEPARATION_CHUNK_SECONDS=30
DUB_SEPARATION_CONTEXT_SECONDS=2
DUB_SEPARATION_BATCH_SIZE=1
#
# TTS: VieNeu v2 (4096 MiB), chạy 1 câu/block, không giữ model khác
# cùng lúc. Piper (0 VRAM, CPU) là fallback khi VieNeu OOM.
DUB_DEFAULT_TTS_MODEL_ID=tts-vieneu-v2
#
# Dịch: preset này giả định dịch qua API (0 VRAM) — chọn backend API
# trên dashboard rồi nhập base URL + key. Nếu nhất quyết dịch local,
# model duy nhất vừa 6 GB là Gemma E2B Q4 (6144 MiB, vẫn sát nút) và
# nó phải chạy RIÊNG, không cùng lúc với stage GPU khác:
# DUB_DEFAULT_TRANSLATION_MODEL_ID=mt-gemma4-e2b-q4
#
# Quy tắc vàng, nhắc lại: không bao giờ chạy 2 model GPU cùng lúc.
# Pipeline đã tách stage và đóng model sau mỗi stage — giữ nguyên.
DUB_COMPUTE_MODE=gpu
